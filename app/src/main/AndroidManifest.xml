<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Deixa a app usar a internet (Firebase e Google Maps). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Deixa a app saber a localização do telemóvel (aproximada e precisa). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Deixa a app procurar redes Wi-Fi (para saber se o aluno está na biblioteca). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MapaISEP">

        <!-- Chave do Google Maps. Vem do local.properties, que não vai para o GitHub. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Primeiro ecrã a abrir quando a app arranca. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">

            <intent-filter>
                <!-- MAIN: este ecrã é a porta de entrada da app (o primeiro a abrir). -->
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER: põe o ícone da app na lista de aplicações do telemóvel;
                     tocar no ícone abre este ecrã. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Ecrã principal (Início e Mapa), aberto depois do login. -->
        <activity
            android:name=".ui.MenuPrincipalActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AmigosActivity"
            android:exported="false" />
        <activity android:name=".ui.PerfilActivity" android:exported="false" />

        <!-- Horário de hoje de um amigo, aberto a partir da lista de amigos. -->
        <activity android:name=".ui.HorarioAmigoActivity" android:exported="false" />

    </application>

</manifest>
