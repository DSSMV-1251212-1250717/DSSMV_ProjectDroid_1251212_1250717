<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/campus_background" android:fillViewport="true" android:fitsSystemWindows="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_campus_hero" android:padding="24dp">
            <TextView style="@style/CampusLabel" android:text="@string/campus_brand" android:textColor="@color/campus_accent" android:letterSpacing="0.18" />
            <TextView style="@style/CampusLabel" android:text="@string/campus_tagline" android:layout_marginTop="12dp" android:textSize="30sp" android:textColor="@color/white" />
            <ImageView android:layout_width="match_parent" android:layout_height="110dp" android:src="@drawable/illustration_campus" android:importantForAccessibility="no" android:scaleType="fitCenter" android:layout_marginTop="12dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp" android:background="@drawable/bg_campus_card" android:padding="24dp">
            <TextView style="@style/CampusLabel" android:text="@string/login_title" android:textSize="24sp" />
            <TextView style="@style/CampusBody" android:text="@string/campus_login_intro" android:layout_marginTop="6dp" />
            <TextView style="@style/CampusLabel" android:text="@string/login_username" android:layout_marginTop="24dp" android:labelFor="@id/inputUtilizador" />
            <EditText android:id="@+id/inputUtilizador" style="@style/CampusInput" android:hint="@string/campus_student_hint" android:inputType="number" android:autofillHints="username" android:imeOptions="actionNext" android:maxLength="7" />
            <TextView style="@style/CampusLabel" android:text="@string/login_password" android:layout_marginTop="18dp" android:labelFor="@id/inputPassword" />
            <EditText android:id="@+id/inputPassword" style="@style/CampusInput" android:hint="@string/campus_password_hint" android:inputType="textPassword" android:autofillHints="password" android:imeOptions="actionDone" android:maxLength="10" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="24dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingVertical="14dp" android:text="@string/login_button" android:textAllCaps="false" android:textSize="16sp" android:textColor="@color/white" app:backgroundTint="@color/campus_hero" app:cornerRadius="16dp" />
            <TextView android:id="@+id/errorLogin" style="@style/CampusBody" android:layout_marginTop="12dp" android:background="@drawable/bg_campus_error" android:padding="12dp" android:textColor="@color/campus_error" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        </LinearLayout>
        <TextView style="@style/CampusBody" android:text="@string/campus_footer" android:layout_marginTop="24dp" android:gravity="center" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>