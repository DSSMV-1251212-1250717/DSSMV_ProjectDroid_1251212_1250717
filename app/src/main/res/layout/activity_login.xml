<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_campus_card"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/isep_logo_description"
                    android:scaleType="fitCenter" />

                <TextView
                    style="@style/CampusLabel"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/campus_brand"
                    android:textColor="@color/black"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                style="@style/CampusBody"
                android:layout_marginTop="12dp"
                android:textColor="@color/black"
                android:text="@string/campus_tagline" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/isep_campus_map"
                android:contentDescription="@string/campus_map_image_description"
                android:scaleType="fitCenter"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_campus_map"
                android:clipToOutline="true"
                android:elevation="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_campus_card"
            android:padding="24dp">

            <TextView
                style="@style/CampusLabel"
                android:text="@string/login_title"
                android:textColor="@color/black"
                android:textSize="24sp" />

            <TextView
                style="@style/CampusBody"
                android:layout_marginTop="6dp"
                android:textColor="@color/black"
                android:text="@string/campus_login_intro" />

            <TextView
                style="@style/CampusLabel"
                android:layout_marginTop="24dp"
                android:labelFor="@id/inputUtilizador"
                android:textColor="@color/black"
                android:text="@string/login_username" />

            <EditText
                android:id="@+id/inputUtilizador"
                style="@style/CampusInput"
                android:hint="@string/campus_student_hint"
                android:inputType="number"
                android:autofillHints="username"
                android:imeOptions="actionNext"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:maxLength="7" />

            <TextView
                style="@style/CampusLabel"
                android:layout_marginTop="18dp"
                android:labelFor="@id/inputPassword"
                android:textColor="@color/black"
                android:text="@string/login_password" />

            <EditText
                android:id="@+id/inputPassword"
                style="@style/CampusInput"
                android:hint="@string/campus_password_hint"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:maxLength="10" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="14dp"
                android:text="@string/login_button"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:backgroundTint="@color/campus_button_red"
                app:cornerRadius="16dp" />

            <TextView
                android:id="@+id/errorLogin"
                style="@style/CampusBody"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campus_error"
                android:padding="12dp"
                android:textColor="@color/black"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/CampusBody"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/campus_footer"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
