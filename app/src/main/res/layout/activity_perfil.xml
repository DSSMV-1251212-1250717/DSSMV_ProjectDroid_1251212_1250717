<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/campus_background"
    android:padding="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end">
        <ImageButton
            android:id="@+id/btnMenuPerfil"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_menu_hamburger"
            android:contentDescription="@string/open_account_menu"
            android:background="@color/white"
            android:padding="12dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
    <TextView style="@style/CampusLabel" android:layout_marginTop="28dp" android:text="@string/profile_title" android:textSize="28sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:orientation="vertical" android:padding="20dp"
        android:gravity="center_horizontal" android:background="@drawable/bg_campus_card">
        <ImageView
            android:id="@+id/imagemPerfil"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_profile_photo"
            android:contentDescription="@string/profile_photo_description"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_campus_pin" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlterarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/profile_change_photo"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/campus_button_red" />
        <TextView style="@style/CampusBody" android:text="@string/profile_number" />
        <TextView android:id="@+id/textoNumeroPerfil" style="@style/CampusLabel" android:text="…" android:textSize="22sp" />
        <TextView style="@style/CampusBody" android:layout_marginTop="20dp" android:text="@string/profile_class" />
        <TextView android:id="@+id/textoTurmaPerfil" style="@style/CampusLabel" android:text="…" android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
